rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real server-side auth: admin login now goes through Firebase
    // Authentication (see src/App.jsx + Firebase Console → Authentication).
    // These rules are enforced by Firebase's servers, not the browser —
    // a signed-out visitor genuinely cannot write products or read orders,
    // no matter what they do in devtools.
    match /stepby/{docId} {
      // Product catalog: public storefront needs to read it; only a
      // signed-in admin can change it.
      allow read: if docId == "products";
      allow write: if docId == "products" && request.auth != null;

      // Orders: checkout must work for signed-out customers, so creating/
      // updating the shared orders doc stays open — but only a signed-in
      // admin can read it back, since it holds customer names, phone
      // numbers and addresses.
      allow read: if docId == "orders" && request.auth != null;
      allow write: if docId == "orders" && request.resource.data.value is list;

      // Everything else (including the old plaintext "credentials" doc,
      // which this app no longer uses) is fully locked down.
      allow read, write: if false;
    }
  }
}
