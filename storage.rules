rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photos: anyone visiting the store must be able to view them,
    // but only a signed-in admin can upload/replace/delete them.
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else stays locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
